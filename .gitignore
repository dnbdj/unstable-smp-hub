# vercel (project.json is committed on purpose: it binds deploys to the
# project ID so they keep working across renames)
.vercel/*
!.vercel/project.json

# android wrapper build outputs (rebuild with android/Build-Apk.bat)
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/local.properties

# packages
*.apk
*.aab
node_modules/
